{
  "name": "monochat",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "vite --port 3000 --strictPort",
    "db:generate": "drizzle-kit generate",
    "db:push": "bun run server/db/migrate.ts",
    "build": "vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "lint": "tsc --noEmit",
    "test": "bun run scripts/verify-e2e.ts",
    "test:extended": "bun run scripts/verify-extended.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.132.0",
    "@types/ws": "^8.18.2",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.9.12",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.22.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/router-devtools": "^1.132.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
